# ============================================================================
# LLM API Keys - Set your actual keys here
# ============================================================================

# GOOGLE GEMINI API KEYS
# ---
# Choose ONE of the following options:
#
# Option 1: Single API key (used by GoogleGeminiClient for single requests)
GEMINI_API_KEY=your-google-api-key-here

# Option 2: Alternative name for single key (also supported for compatibility)
# GOOGLE_API_KEY=your-google-api-key-here

# Option 3: Multiple API keys for key rotation in ResilientLLMClient
# Comma-separated list of keys. Used when LLM_RESILIENCE_ENABLED=1 and multiple keys are provided
# GEMINI_API_KEYS="key1, key2, key3"

# ============================================================================
# OPENAI API KEYS
# ---
# Choose ONE of the following options:
#
# Option 1: Single API key (used by OpenAIClient for single requests)
OPENAI_API_KEY=your-openai-api-key-here

# Option 2: Multiple API keys for key rotation in ResilientLLMClient
# Comma-separated list of keys. Used when LLM_RESILIENCE_ENABLED=1 and multiple keys are provided
# OPENAI_API_KEYS="key1, key2, key3"

# ============================================================================
# LLM RESILIENCE CONFIGURATION
# ---
# Enable resilience features for LLM clients (retries, rate limiting, key rotation)
# Set to 1/true/yes to enable, 0/false/no to disable
# When enabled:
#   - Automatic retries on failures with exponential backoff
#   - Rate limiting and concurrency control
#   - API key rotation (if multiple keys are provided via *_API_KEYS env vars)
LLM_RESILIENCE_ENABLED=0

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - Never commit real API keys to version control
# - Use environment-specific .env files or system environment variables
# - Keep sensitive credentials out of source code repositories
# - Consider using secrets management solutions for production environments