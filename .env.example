# LLM API Keys - Set your actual keys here
# For Google Gemini (used by GoogleGeminiClient)
GOOGLE_API_KEY=your-google-api-key-here
# Alternative name also supported
GEMINI_API_KEY=your-google-api-key-here

# For OpenAI (used by OpenAIClient)  
OPENAI_API_KEY=your-openai-api-key-here

# Note: Never commit real API keys to version control
# Use environment-specific .env files or system environment variables